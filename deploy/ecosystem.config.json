{
  "apps": [
    {
      "name": "rutmy-admin",
      "script": "npx",
      "args": "next start -p 3003",
      "cwd": "/DATA/AppData/scertta_workspace/scertta-app/apps/scertta_admin_web",
      "instances": 1,
      "exec_mode": "fork",
      "env": {
        "NODE_ENV": "production",
        "NEXT_PUBLIC_SUPABASE_URL": "https://TU_PROYECTO.supabase.co",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY": "FROM_ENV_FILE",
        "NEXT_PUBLIC_APP_MODE": "ceo",
        "VALHALLA_URL": "http://localhost:8002",
        "MARTIN_URL": "http://localhost:3000"
      },
      "max_memory_restart": "1G",
      "autorestart": true,
      "watch": false
    },
    {
      "name": "valhalla-router",
      "script": "docker",
      "args": "start -a valhalla-router",
      "cwd": "/DATA/docker/valhalla",
      "instances": 1,
      "exec_mode": "fork",
      "autorestart": true
    },
    {
      "name": "martin-tiles",
      "script": "docker",
      "args": "start -a martin-tiles",
      "cwd": "/DATA/docker/martin",
      "instances": 1,
      "exec_mode": "fork",
      "autorestart": true
    }
  ]
}
