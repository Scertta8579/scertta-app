# =============================================================================
# Scertta Rider (solicitante) — variables de entorno (Flutter)
# =============================================================================
# Pasá estas claves con --dart-define al ejecutar o compilar (ver Driver .env.example).
#
#   flutter run --dart-define=SUPABASE_URL=https://TU_PROYECTO.supabase.co ^
#     --dart-define=SUPABASE_ANON_KEY=TU_ANON_KEY_JWT ^
#     --dart-define=MAPBOX_ACCESS_TOKEN=pk.TU_MAPBOX_TOKEN
#
# En release, son obligatorias (sin ellas la app lanza error al iniciar).
# En debug, existen fallbacks en lib/config/app_env.dart solo para desarrollo.
#
# FCM: google-services.json → android/app/  |  GoogleService-Info.plist → ios/Runner/
# Ver también lib/firebase_options.dart y `flutterfire configure`.
# =============================================================================

SUPABASE_URL=
SUPABASE_ANON_KEY=
MAPBOX_ACCESS_TOKEN=
